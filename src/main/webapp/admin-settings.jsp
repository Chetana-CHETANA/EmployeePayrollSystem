<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login Settings - PayrollPro</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/style.css" rel="stylesheet"></head><body><div class="container-fluid"><div class="row"><jsp:include page="/includes/sidebar.jsp"/><main class="col-md-10 col-lg-10 content"><div class="d-flex justify-content-between align-items-center mb-4"><h2>Login Settings</h2><span class="text-muted">Welcome, ${sessionScope.admin.username}</span></div><div class="card p-4" style="max-width:700px"><h5>Change Admin Login</h5><p class="text-muted">Change the username and password anytime.</p><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><c:if test="${not empty success}"><div class="alert alert-success">${success}</div></c:if><form method="post" action="${pageContext.request.contextPath}/admin-settings"><div class="mb-3"><label class="form-label">New Username</label><input type="text" class="form-control" name="username" value="${currentUsername}" required minlength="3"></div><div class="mb-3"><label class="form-label">New Password</label><input type="password" class="form-control" name="password" required minlength="6"></div><div class="mb-4"><label class="form-label">Confirm New Password</label><input type="password" class="form-control" name="confirmPassword" required minlength="6"></div><button class="btn btn-primary">Update Login Credentials</button></form></div></main></div></div></body></html>